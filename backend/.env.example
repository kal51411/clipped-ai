# Clipped-AI Environment Configuration
APP_NAME=Clipped-AI
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True
SHOW_DOCS=True
AUTO_CREATE_TABLES=True

# Server
HOST=0.0.0.0
PORT=8000

# CORS (comma separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database
# Local SQLite for immediate development:
DATABASE_URL=sqlite+aiosqlite:///./clipped_ai.db
DATABASE_SYNC_URL=sqlite:///./clipped_ai.db
# For PostgreSQL / Supabase:
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/clipped_ai
# DATABASE_SYNC_URL=postgresql://postgres:password@localhost:5432/clipped_ai

# Security (generate with: openssl rand -hex 32)
SECRET_KEY=dev_secret_key_clipped_ai_change_in_production_998877665544332211
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Gemini AI (Get key from https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Whisper (faster-whisper)
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Storage Backend (local or s3)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage
OUTPUT_DIR=./output
TEMP_DIR=/tmp/clipped_ai

# Cloudflare R2 / S3 (optional)
# S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=clipped-ai-media
# S3_REGION=auto
# S3_PUBLIC_URL_BASE=https://cdn.yourdomain.com

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Video Processing Defaults
MAX_UPLOAD_SIZE_MB=2048
DEFAULT_CLIP_DURATION_SECONDS=60
